doctype html
html(lang="en")

  //- HTML HEADER
  head
    meta(charset="utf-8")
    meta(name="description", content=description)
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="robots", content="index,follow")

    meta(property="fb:app_id", content="235461346984404")
    meta(property="og:type", content="website")
    meta(property="og:image", content="https://jumpin.chat/images/jiclogo_320x320.png")
    meta(property="og:title", content="Simple video chatrooms | JumpInChat")
    meta(property="og:url", content="https://jumpin.chat/")
    meta(property="og:description", content=description)

    meta(name="twitter:title", content="Simple video chatrooms | JumpInChat")
    meta(name="twitter:description", content=description)
    meta(name="twitter:card", content="summary")
    meta(name="twitter:image", content="https://jumpin.chat/images/jiclogo_320x320.png")
    meta(name="twitter:url", content="https://jumpin.chat/")

    title= section + ' | JumpInChat'

    link(rel="canonical", href="https://jumpin.chat" + path)

    link(rel="preconnect", href="https://fonts.gstatic.com/", crossorigin)
    link(media="(min-width: 768px)",
      href="https://fonts.googleapis.com/css?family=Dosis:600,700|Noto+Sans:400,400i,700,700i",
      rel="stylesheet")

    link(rel="stylesheet", href="/fontawesome/css/all.min.css")
    link(rel="stylesheet", href="/fontawesome/css/v4-shims.min.css")

    link(rel="shortcut icon", href="/images/favicon.png", type="image/x-icon")

    //- Customise the stylesheet for your site by editing /public/styles/site.sass
    link(href=asset('/styles/site.css'), rel="stylesheet")

    //- Include template-specific stylesheets by extending the css block
    block css

    //- Add any other template-specific HEAD tags by extending the head block
    block head

  //- HTML BODY
  body
    block content


    include ../includes/footer.pug

    //- Add scripts that are globally required by your site here.

    if ldJson
      script(type="application/ld+json") !{JSON.stringify(ldJson)}

    script(src=asset('/js/app.js'), type="module")
    if supportEnabled
      script(src='https://js.stripe.com/v3/')

    //- Include template-specific javascript files by extending the js block
    block js
