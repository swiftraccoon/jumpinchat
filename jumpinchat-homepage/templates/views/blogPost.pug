extends ../layouts/default

block content
  .site-wrapper
    include ../includes/header
    section.full-width
      .wrapper
        article.blog__post
          header.blog__postHeader
            h2.page-header= post.title
            time.blog__postDate(datetime=post.date)= new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
          .blog__postContent !{post.content}
          nav.blog__nav
            a(href="/blog") &larr; Back to all posts
