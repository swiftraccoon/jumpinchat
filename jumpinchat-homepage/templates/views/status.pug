extends ../layouts/default

block head
  meta(http-equiv="refresh" content="60")

block content
  .site-wrapper
    include ../includes/header
    section.full-width
      .wrapper
        h1.page-header Service Status
        p Current health of JumpInChat backend services.

        .status-list
          each service in services
            .status-list__item
              .status-list__indicator(
                class={
                  'status-list__indicator--operational': service.status === 'operational',
                  'status-list__indicator--degraded': service.status === 'degraded',
                  'status-list__indicator--down': service.status === 'down'
                }
              )
              .status-list__details
                span.status-list__name= service.name
                span.status-list__label= service.status
              span.status-list__response= service.responseTime + ' ms'

        p.status-list__checked Last checked: #{lastChecked}

        style.
          .status-list {
            margin: 2rem 0;
          }
          .status-list__item {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-bottom: 1px solid #e0e0e0;
          }
          .status-list__item:last-child {
            border-bottom: none;
          }
          .status-list__indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 1rem;
            flex-shrink: 0;
          }
          .status-list__indicator--operational {
            background-color: #4caf50;
          }
          .status-list__indicator--degraded {
            background-color: #ff9800;
          }
          .status-list__indicator--down {
            background-color: #f44336;
          }
          .status-list__details {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
          }
          .status-list__name {
            font-weight: 700;
            font-size: 1.1rem;
          }
          .status-list__label {
            text-transform: capitalize;
            font-size: 0.9rem;
            color: #666;
          }
          .status-list__response {
            font-size: 0.9rem;
            color: #999;
            white-space: nowrap;
          }
          .status-list__checked {
            margin-top: 2rem;
            font-size: 0.85rem;
            color: #999;
          }
