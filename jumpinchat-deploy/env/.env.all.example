# JumpInChat — All-in-one single-server deployment
# Copy to .env in jumpinchat-deploy/ and fill in values

# === Secrets ===
JWT_SECRET=
COOKIE_SECRET=
SHARED_SECRET=
FILE_TOKEN_SECRET=
JANUS_TOKEN_SECRET=

# === Third-party ===
YT_API_KEY=
GCM_API_KEY=
STRIPE_SK=
STRIPE_WH_KEY=
STRIPE_KEY_PUBLIC=

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JumpInChat <noreply@example.com>

# === Janus Media ===
JANUS_NAT_IP=192.168.88.197

# === Storage ===
# "local" uses shared Docker volume, "s3" uses MinIO/S3-compatible
STORAGE_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=