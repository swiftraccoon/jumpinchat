# JumpInChat — All-in-one single-server deployment
# Copy to .env in jumpinchat-deploy/ and fill in values

# === Secrets ===
JWT_SECRET=
COOKIE_SECRET=
SHARED_SECRET=
FILE_TOKEN_SECRET=
JANUS_TOKEN_SECRET=

# === Third-party ===
YT_API_KEY=
GCM_API_KEY=
STRIPE_SK=
STRIPE_WH_KEY=
STRIPE_KEY_PUBLIC=

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JumpInChat <noreply@example.com>

# === Janus Media ===
JANUS_NAT_IP=

# === Storage ===
# "local" uses shared Docker volume, "s3" uses external S3-compatible storage
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads
# Optional: browser error reporting (disabled when empty)
SENTRY_DSN=

# Optional for LAN use; comma-separated TURN server hostnames
TURN_URIS=

# External S3: leave endpoint empty for AWS; expose only public/ through the origin.
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Required when TURN_URIS is set; same secret as the TURN relay.
TURN_SHARED_SECRET=
# For the optional compose.turn.yml relay:
TURN_REALM=
TURN_EXTERNAL_IP=
