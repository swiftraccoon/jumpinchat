# JumpInChat — Lite single-server deployment (compose.lite.yml)
# Copy to .env in jumpinchat-deploy/ and fill in values

# === Secrets ===
JWT_SECRET=
COOKIE_SECRET=
SHARED_SECRET=
FILE_TOKEN_SECRET=
JANUS_TOKEN_SECRET=

# === Third-party (all optional; features disable cleanly when unset) ===
YT_API_KEY=
GCM_API_KEY=
STRIPE_SK=
STRIPE_WH_KEY=
STRIPE_KEY_PUBLIC=
SENTRY_DSN=

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JumpInChat <noreply@example.com>

# === Janus Media ===
# Public IP of this server, used for WebRTC NAT traversal
JANUS_NAT_IP=

# === TURN (optional, comma-separated URIs) ===
TURN_URIS=

# === Storage ===
# "local" uses shared volume, "s3" uses MinIO/S3-compatible
STORAGE_BACKEND=local
