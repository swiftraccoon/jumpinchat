# JumpInChat — Media server environment
# For multi-server: copy to .env on the media server

# Janus token auth secret (must match app server)
JANUS_TOKEN_SECRET=

# Public IP of this server (for Janus NAT traversal)
JANUS_NAT_IP=

# RTP port ranges (default: 20000-20100 for janus, 20101-20200 for janus2)
# RTP_PORT_MIN=20000
# RTP_PORT_MAX=20200
