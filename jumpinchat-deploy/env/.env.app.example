# Public HTTPS origin used by account emails and canonical page links.
PUBLIC_BASE_URL=https://jumpin.chat

# JumpInChat — App server environment
# For multi-server: copy to .env on the app server

# === Secrets ===
JWT_SECRET=
COOKIE_SECRET=
SHARED_SECRET=
FILE_TOKEN_SECRET=
JANUS_TOKEN_SECRET=
STRIPE_SK=
STRIPE_WH_KEY=
STRIPE_KEY_PUBLIC=
YT_API_KEY=
GCM_API_KEY=

# === Remote services (set to actual host IPs/names) ===
MONGODB_URI=mongodb://db-server:27017/tc?replicaSet=rs0
REDIS_URI=redis://db-server:6379
EMAIL_URL=http://email-server:3001

# === Janus (on media server) ===
JANUS_SERVER_IDS=janus,janus2
TURN_URIS=media-server

# === Storage ===
STORAGE_BACKEND=local
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=uploads

# === Nginx upstream hosts (for multi-server) ===
# WEB_HOST=web
# WEB2_HOST=web2
# HOME_HOST=home
# HOME2_HOST=home2
# HAPROXY_HOST=haproxy
# JANUS_WS_HOST=media-server
# JANUS2_WS_HOST=media-server
# JANUS_HTTP_HOST=media-server

# === Email (SMTP — only if email runs on this server) ===
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=JumpInChat <noreply@example.com>

# Optional: browser error reporting (disabled when empty)
SENTRY_DSN=

# External S3: leave endpoint empty for AWS; expose only public/ through the origin.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Required when TURN_URIS is set; same secret as the TURN relay.
TURN_SHARED_SECRET=
# For the optional compose.turn.yml relay:
TURN_REALM=
TURN_EXTERNAL_IP=
