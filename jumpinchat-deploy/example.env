# Public HTTPS origin used by account emails and canonical page links.
PUBLIC_BASE_URL=https://jumpin.chat

JWT_SECRET=dev-jwt-secret-change-me
COOKIE_SECRET=dev-cookie-secret-change-me
JANUS_TOKEN_SECRET=change-me-to-a-random-secret
YT_API_KEY=dummy
FILE_TOKEN_SECRET=dev-file-token-secret-change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JumpInChat <noreply@example.com>
GCM_API_KEY=
STRIPE_SK=
STRIPE_WH_KEY=
STRIPE_KEY_PUBLIC=
SHARED_SECRET=change-me-to-a-random-secret

# Storage backend: "local" (default) or "s3" (external S3-compatible storage)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads


# Janus NAT IP (set to public IP of media server)
JANUS_NAT_IP=

# Nginx upstream hosts (for multi-server deployment, uncomment and set)
# WEB_HOST=web
# WEB2_HOST=web2
# HOME_HOST=home
# HOME2_HOST=home2
# HAPROXY_HOST=haproxy
# JANUS_WS_HOST=janus
# JANUS2_WS_HOST=janus2
# JANUS_HTTP_HOST=janus

# Optional: browser error reporting (disabled when empty)
SENTRY_DSN=

# Optional for LAN use; comma-separated TURN server hostnames
TURN_URIS=

# External S3: leave endpoint empty for AWS; expose only public/ through the origin.
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Required when TURN_URIS is set; same secret as the TURN relay.
TURN_SHARED_SECRET=
# For the optional compose.turn.yml relay:
TURN_REALM=
TURN_EXTERNAL_IP=
